# Copy to .env. Never commit .env or put credentials in client-side variables.
SPACE_NAME=Семейное пространство
# Up to five family surnames shown on invitations. Structured names in the tree supplement these.
# Use this for legacy names that have not yet been split into separate fields.
FAMILY_SURNAMES=
ADMIN_EMAIL=
PUBLIC_ORIGIN=

# Telegram Login: BotFather > your bot > Login Widget.
# Register PUBLIC_ORIGIN and PUBLIC_ORIGIN/api/auth/telegram/callback.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Your personal numeric Telegram user ID, NOT the bot/client ID.
ADMIN_TELEGRAM_ID=
# ADMIN_EMAIL above is only for identifying a legacy administrator during migration.

# Optional AI. Empty key leaves manual work available.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
EXTRACTION_MODEL=gpt-4.1-mini
CHAT_MODEL=gpt-4.1-mini
CHAT_REQUEST_TIMEOUT_MS=90000
CHAT_MAX_OUTPUT_TOKENS=1200
AI_MAX_DURATION_SECONDS=7200
AI_REQUEST_TIMEOUT_MS=120000
AI_PROCESS_TIMEOUT_MS=600000
MAX_UPLOAD_MB=250
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_PREVIEW_TIMEOUT_MS=180000
MEDIA_PREVIEW_MAX_MB=500

# Local preview only: run with DEV_AUTH=1 HOST=127.0.0.1 npm run dev.
# Production Compose sets NODE_ENV, HOST, PORT, TRUST_PROXY and DEV_AUTH itself.
# DATA_DIR defaults to ./data locally and /var/lib/family-space/data in Compose.
# Leave DATA_DIR unset unless deliberately selecting a restored directory.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# HEIF_CONVERT_PATH=heif-convert
