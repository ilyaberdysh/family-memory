# Paste into Coolify > Application > Environment Variables > Developer view.
# Runtime enabled, Build Variable disabled. Replace the example HTTPS domain.
NODE_ENV=production
DEV_AUTH=0
HOST=0.0.0.0
PORT=4317
TRUST_PROXY=1
PUBLIC_ORIGIN=https://family.example.com
DATA_DIR=/var/lib/family-space/data
SPACE_NAME=Семейный архив
# Optional: up to five comma-separated surnames shown publicly on invitations.
FAMILY_SURNAMES=

# Leave all three empty for the first deployment; login remains unavailable.
# Configure these together before the first real Telegram login.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
ADMIN_TELEGRAM_ID=

# Optional AI; manual tree/archive work does not need an API key.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
EXTRACTION_MODEL=gpt-4.1-mini
CHAT_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=250

# Automatic local snapshots in the same volume, outside DATA_DIR. They protect against
# mistakes and damaged files, not against losing the server: add an off-site copy (DEPLOYMENT.md, section 6).
BACKUP_DIR=/var/lib/family-space/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_FIRST_DELAY_MINUTES=10
# Uploads are refused below this free space; admins see a warning.
MIN_FREE_DISK_MB=1024
SHUTDOWN_TIMEOUT_MS=50000
REQUEST_TIMEOUT_SECONDS=3600
MEDIA_PREVIEW_CONCURRENCY=1
# Never set ALLOW_EPHEMERAL_DATA here: the startup guard protects against a missing volume.

# Coolify > Persistent Storage > Volume (configure separately from env):
# Name: family-memory-data
# Destination Path: /var/lib/family-space
# One instance; Consistent Container Names enabled to prevent deploy overlap.
# Stop grace period of at least 75 s, and a proxy read timeout for large uploads (DEPLOYMENT.md, section 7).
